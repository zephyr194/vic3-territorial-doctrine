  "doctrines": {
    "status_quo": {
      "zh": "领土现状主义",
      "en": "Territorial Status Quo",
      "focus_limit": 0,
      "bureaucracy": 0,
      "authority": 0,
      "wait_months": 0,
      "infamy": 0,
      "cost_multiplier": 1,
      "political_strength": {},
      "country_modifiers": {},
      "description": {
        "zh": "维护现有边界，把政治与行政资源用于国内建设。这一原则仅提供领土理由与集团偏好的背景，不直接增加产能、政治力量或合法性。",
        "en": "Preserve existing borders and direct political and administrative resources toward domestic development. This doctrine frames territorial arguments and group preferences; it grants no direct production, political-strength or legitimacy bonus."
      },
      "eligibility": {
        "zh": "不提出新领土宣称；仍可逐州接纳已有领土或放弃失地宣称。",
        "en": "Does not propose territorial claims; owned states may still be admitted individually and lost claims relinquished."
      },
      "industry_modifiers": {},
      "territory_modifiers": {},
      "acquisition_reaction": {
        "radicals": 0,
        "loyalists": 0
      }
    },
    "historical_rights": {
      "zh": "历史权利主义",
      "en": "Historical Rights",
      "focus_limit": 1,
      "bureaucracy": 0,
      "authority": 0,
      "wait_months": 0,
      "infamy": 0,
      "cost_multiplier": 1,
      "political_strength": {},
      "country_modifiers": {},
      "description": {
        "zh": "以既有法理和主体文化家园维护国家疆界，将恢复合法领土置于无条件扩张之前。这一原则仅提供领土理由与集团偏好的背景，不直接增加产能、政治力量或合法性。",
        "en": "Ground national borders in existing legal claims and primary-cultural homelands, placing lawful restoration ahead of unrestricted expansion. This doctrine frames territorial arguments and group preferences; it grants no direct production, political-strength or legitimacy bonus."
      },
      "eligibility": {
        "zh": "仅可主张已有真实宣称或主体文化家园的外国州；不凭重点区域创造历史权利。",
        "en": "Foreign targets require an existing real claim or a primary-cultural homeland; a focus region does not create historical rights."
      },
      "industry_modifiers": {},
      "territory_modifiers": {},
      "acquisition_reaction": {
        "radicals": 0,
        "loyalists": 0
      }
    },
    "strategic_frontiers": {
      "zh": "战略边疆主义",
      "en": "Strategic Frontiers",
      "focus_limit": 2,
      "bureaucracy": 0,
      "authority": 0,
      "wait_months": 0,
      "infamy": 0,
      "cost_multiplier": 1,
      "political_strength": {},
      "country_modifiers": {},
      "description": {
        "zh": "通过有限扩张保障边境与区域安全。这一原则仅提供领土理由与集团偏好的背景，不直接增加产能、政治力量或合法性。",
        "en": "Pursue limited expansion to secure borders and regional interests. This doctrine frames territorial arguments and group preferences; it grants no direct production, political-strength or legitimacy bonus."
      },
      "eligibility": {
        "zh": "可主张相邻州，或有原版区域利益、且符合当前殖民或航道安全依据的远方目标。",
        "en": "Claims cover adjacent states, or distant targets with a vanilla regional interest and a qualifying colonial or sea-lane security basis."
      },
      "industry_modifiers": {},
      "territory_modifiers": {},
      "acquisition_reaction": {
        "radicals": 0,
        "loyalists": 0
      }
    },
    "imperial_expansion": {
      "zh": "帝国扩张主义",
      "en": "Imperial Expansion",
      "focus_limit": 3,
      "bureaucracy": 0,
      "authority": 0,
      "wait_months": 0,
      "infamy": 0,
      "cost_multiplier": 1,
      "political_strength": {},
      "country_modifiers": {},
      "description": {
        "zh": "把海外扩张与国家威望列为长期国策。这一原则仅提供领土理由与集团偏好的背景，不直接增加产能、政治力量或合法性。",
        "en": "Make overseas expansion and national prestige a permanent state mission. This doctrine frames territorial arguments and group preferences; it grants no direct production, political-strength or legitimacy bonus."
      },
      "eligibility": {
        "zh": "可对已有原版区域利益的合格外国州提出主张；每个目标仍须单独通过宣称法案。",
        "en": "Eligible foreign states in regions with a vanilla regional interest may be claimed; each target still needs its own approved bill."
      },
      "industry_modifiers": {},
      "territory_modifiers": {},
      "acquisition_reaction": {

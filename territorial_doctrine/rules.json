  "group_politics": {
    "armed_forces": {
      "zh": "武装力量",
      "en": "Armed Forces",
      "rationale": {
        "zh": "重视国防部署与军方影响力，偏向战略边疆，反对削弱军事议程的守成政策。",
        "en": "Prioritize defense deployments and military influence, favoring strategic frontiers over policies that restrain the military agenda."
      }
    },
    "landowners": {
      "zh": "地主",
      "en": "Landowners",
      "rationale": {
        "zh": "维护土地、传统权利与精英地位，倾向历史权利和帝国扩张。",
        "en": "Defend landed wealth, traditional rights and elite standing, favoring historical claims and imperial expansion."
      }
    },
    "industrialists": {
      "zh": "实业家",
      "en": "Industrialists",
      "rationale": {
        "zh": "寻求对外市场与建设机会，偏向边疆和帝国扩张，重视殖民政策的商业取舍。",
        "en": "Seek external markets and investment opportunities, favoring frontier and imperial expansion while weighing colonial commercial policy."
      }
    },
    "petty_bourgeoisie": {
      "zh": "小市民",
      "en": "Petty Bourgeoisie",
      "rationale": {
        "zh": "强调国家认同与合法疆界，最重视历史权利，也支持有限边疆政策。",
        "en": "Emphasize national identity and lawful borders, preferring historical rights while supporting limited frontier policies."
      }
    },
    "intelligentsia": {
      "zh": "知识分子",
      "en": "Intelligentsia",
      "rationale": {
        "zh": "重视居民权利与国内改革，倾向现状主义，反对帝国扩张；人文科技提高接纳意愿。",
        "en": "Prioritize residents’ rights and domestic reform, favoring the status quo over imperial expansion; humanitarian research encourages admission."
      }
    },
    "trade_unions": {
      "zh": "工会",
      "en": "Trade Unions",
      "rationale": {
        "zh": "重视劳工权利与公共服务，反对扩张挤占民生资源，支持给予新居民平等权利。",
        "en": "Prioritize labor rights and public services, resisting expansion that diverts domestic resources and supporting equal rights for new residents."
      }
    },
    "rural_folk": {
      "zh": "乡村民众",
      "en": "Rural Folk",
      "rationale": {
        "zh": "重视土地生活与低征兵负担，倾向守成，警惕持续扩张带来的战争与财政压力。",
        "en": "Prioritize rural livelihoods and limited conscription, favoring restraint over the war and fiscal burdens of sustained expansion."
      }
    },
    "devout": {
      "zh": "虔信者",
      "en": "Devout",
      "rationale": {
        "zh": "重视传统共同体与历史合法性，偏向历史权利；殖民政策与人文发展会调整其立场。",
        "en": "Value traditional communities and historical legitimacy, favoring historical rights while responding to colonial and humanitarian policy."
      }
    }
  },

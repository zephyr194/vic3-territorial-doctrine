  "group_politics": {
    "armed_forces": {
      "zh": "武装力量",
      "en": "Armed Forces",
      "rationale": {
        "zh": "争取战略空间、基地与可负担的军事任务；扩张需求不等于所有远征都有实际收益。",
        "en": "Seek strategic space, bases and affordable military missions; a desire to expand does not make every expedition beneficial."
      }
    },
    "landowners": {
      "zh": "地主",
      "en": "Landowners",
      "rationale": {
        "zh": "优先保护既有土地制度、收益与地位；制度保障须记录实际法律和期限，不能把扩张自动当作土地收益。",
        "en": "Protect existing land institutions, returns and standing; a guarantee records the actual law and duration, not automatic gains from expansion."
      }
    },
    "industrialists": {
      "zh": "实业家",
      "en": "Industrialists",
      "rationale": {
        "zh": "争取市场准入、有效需求与实际投资；同一市场不算新增准入，铁路兑现不证明已经获得利润。",
        "en": "Seek market access, demand and investment; an existing common market is not new access, and a delivered railway does not prove realized profit."
      }
    },
    "petty_bourgeoisie": {
      "zh": "小市民",
      "en": "Petty Bourgeoisie",
      "rationale": {
        "zh": "争取低税、安全和本地经营/岗位；国家认同与税负诉求需要在同一方案中权衡。",
        "en": "Seek low taxes, security and local opportunities; national identity and tax burdens must be weighed within the same proposal."
      }
    },
    "intelligentsia": {
      "zh": "知识分子",
      "en": "Intelligentsia",
      "rationale": {
        "zh": "争取教育、专业与制度议程；公共教育条款与国家宗教办学可能冲突，实际领袖可以改变扩张立场。",
        "en": "Seek education, professional and institutional agendas; public and state religious schooling can conflict, while actual leaders can change expansion preferences."
      }
    },
    "trade_unions": {
      "zh": "工会",
      "en": "Trade Unions",
      "rationale": {
        "zh": "争取就业待遇、服务和劳动组织；医疗投入可以进入付费谈判，工资和新成员不得凭领土批准虚构。",
        "en": "Seek employment conditions, services and labor organization; funded health commitments are negotiable, but passage does not fabricate wages or new members."
      }
    },
    "rural_folk": {
      "zh": "乡村民众",
      "en": "Rural Folk",
      "rationale": {
        "zh": "争取低税、土地生活与较少动员负担；可通过付费低税保障谈判，可能反对保留地主制度。",
        "en": "Seek low taxes, rural livelihoods and limited mobilization; funded tax guarantees can win support while preserving a landlord regime can cause opposition."
      }
    },
    "devout": {
      "zh": "虔信者",
      "en": "Devout",
      "rationale": {
        "zh": "争取传教、信徒保护与宗教组织空间；具体收益须符合宗教/教育制度和真实投入，不能凭殖民标签加分。",
        "en": "Seek missionary opportunity, protection of believers and organizational space; religious and education laws and actual investment must support the proposal."
      }
    }
  },

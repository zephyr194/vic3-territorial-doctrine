  "doctrines": {
    "status_quo": {
      "zh": "领土现状主义",
      "en": "Territorial Status Quo",
      "focus_limit": 0,
      "bureaucracy": 0,
      "authority": 0,
      "wait_months": 0,
      "infamy": 0,
      "cost_multiplier": 0.8,
      "political_strength": {
        "intelligentsia": 0.1,
        "trade_unions": 0.1,
        "rural_folk": 0.1,
        "armed_forces": -0.1
      },
      "country_modifiers": {
        "country_bureaucracy_mult": 0.05,
        "country_prestige_mult": -0.05,
        "country_infamy_decay_mult": 0.15
      },
      "description": {
        "zh": "维护现有边界，把政治与行政资源用于国内建设。知识分子、工会与乡村民众得到更多影响力，军方的扩张议程受到约束；行政效率提高，但对外威望有所降低。",
        "en": "Preserve existing borders and direct political and administrative resources toward domestic development. Civilian reformers, organized labor and rural communities gain influence over the military expansion agenda. Administration improves at the expense of international prestige."
      },
      "eligibility": {
        "zh": "不提出新领土宣称；仍可逐州接纳已有领土或放弃失地宣称。",
        "en": "Does not propose territorial claims; owned states may still be admitted individually and lost claims relinquished."
      },
      "industry_modifiers": {
        "building_paper_mill_throughput_mult": 0.05,
        "building_food_industry_throughput_mult": 0.05,
        "building_textile_mill_throughput_mult": 0.05
      },
      "territory_modifiers": {
        "state_construction_mult": 0.05,
        "state_migration_pull_mult": 0.15,
        "state_radicals_from_discrimination_mult": -0.15,
        "state_radicals_from_sol_change_mult": -0.1,
        "state_loyalists_from_sol_change_mult": 0.15
      },
      "acquisition_reaction": {
        "radicals": 0,
        "loyalists": 0.02
      }
    },
    "historical_rights": {
      "zh": "历史权利主义",
      "en": "Historical Rights",
      "focus_limit": 1,
      "bureaucracy": 25,
      "authority": 0,
      "wait_months": 6,
      "infamy": 0,
      "cost_multiplier": 0.8,
      "political_strength": {
        "petty_bourgeoisie": 0.15,
        "landowners": 0.1,
        "devout": 0.1
      },
      "country_modifiers": {
        "country_authority_add": 25,
        "country_infamy_generation_mult": -0.1,
        "country_infamy_decay_mult": 0.05
      },
      "description": {
        "zh": "以既有法理和主体文化家园维护国家疆界，将恢复合法领土置于无条件扩张之前。小市民、地主与宗教传统力量获得更大政治影响，国家权威增强；传统精英也因此更有能力阻碍改革。",
        "en": "Ground national borders in existing legal claims and primary-cultural homelands, placing lawful restoration ahead of unrestricted expansion. National-minded middle classes, landed elites and religious authorities gain influence, strengthening state authority and the traditional interests that can resist reform."
      },
      "eligibility": {
        "zh": "仅可主张已有真实宣称或主体文化家园的外国州；不凭重点区域创造历史权利。",
        "en": "Foreign targets require an existing real claim or a primary-cultural homeland; a focus region does not create historical rights."
      },
      "industry_modifiers": {
        "building_group_bg_agriculture_throughput_mult": 0.05,
        "building_group_bg_logging_throughput_mult": 0.05
      },
      "territory_modifiers": {
        "state_construction_mult": 0.1,
        "state_migration_pull_mult": 0.1,
        "state_radicals_from_discrimination_mult": -0.05,
        "state_radicals_from_sol_change_mult": 0,
        "state_loyalists_from_sol_change_mult": 0.1
      },
      "acquisition_reaction": {
        "radicals": 0.01,
        "loyalists": 0.02
      }
    },
    "strategic_frontiers": {
      "zh": "战略边疆主义",
      "en": "Strategic Frontiers",
      "focus_limit": 2,
      "bureaucracy": 50,
      "authority": 25,
      "wait_months": 6,
      "infamy": 2,
      "cost_multiplier": 1.0,
      "political_strength": {
        "armed_forces": 0.15,
        "industrialists": 0.1,
        "rural_folk": -0.1
      },
      "country_modifiers": {
        "country_diplomatic_play_maneuvers_add": 10,
        "country_military_goods_cost_mult": 0.05,
        "country_infamy_generation_mult": 0.1
      },
      "description": {
        "zh": "通过有限扩张保障边境与区域安全。军方负责边疆部署，实业家参与对外建设，两者政治力量提高；外交博弈有更多回旋余地，但军费负担增加，乡村民众的影响力受到挤压。",
        "en": "Pursue limited expansion to secure borders and regional interests. Military planners and industrial sponsors gain political influence, and diplomacy gains room to maneuver. Higher military supply costs and weaker rural representation are the domestic price."
      },
      "eligibility": {
        "zh": "可主张相邻州，或有原版区域利益和成熟重点、且符合当前殖民或航道安全依据的远方目标。",
        "en": "Claims cover adjacent states, or distant targets with a vanilla regional interest, mature focus and a qualifying colonial or sea-lane security basis."
      },
      "industry_modifiers": {
        "building_steel_mill_throughput_mult": 0.05,
        "building_tooling_workshop_throughput_mult": 0.05,
        "building_arms_industry_throughput_mult": 0.05,
        "building_munition_plant_throughput_mult": 0.05,
        "building_shipyard_throughput_mult": 0.05
      },
      "territory_modifiers": {
        "state_construction_mult": 0.15,
        "state_migration_pull_mult": 0.05,
        "state_radicals_from_discrimination_mult": 0.05,
        "state_radicals_from_sol_change_mult": 0.05,
